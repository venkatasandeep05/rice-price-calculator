```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rice Weighment Calculator</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f6f9;
            color: #222;
        }

        .container {
            width: 100%;
            max-width: 700px;
            margin: auto;
            padding: 20px;
        }

        .card {
            background: #ffffff;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
        }

        h1 {
            text-align: center;
            margin: 0 0 8px;
            font-size: 28px;
        }

        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .input-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 7px;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 17px;
            outline: none;
        }

        input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #1976d2;
            color: white;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #125ca3;
        }

        .result {
            display: none;
            margin-top: 28px;
        }

        .result h2 {
            font-size: 21px;
            margin-bottom: 15px;
        }

        .calculation {
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 13px 15px;
            border-bottom: 1px solid #eee;
        }

        .row:last-child {
            border-bottom: none;
        }

        .row span:last-child {
            font-weight: bold;
            text-align: right;
        }

        .highlight {
            background: #f1f7fc;
        }

        .formula {
            margin-top: 18px;
            padding: 15px;
            background: #f1f7fc;
            border-radius: 10px;
            line-height: 1.7;
            font-size: 14px;
        }

        .total {
            margin-top: 18px;
            padding: 20px;
            border-radius: 10px;
            background: #1976d2;
            color: white;
            text-align: center;
        }

        .total-title {
            font-size: 14px;
            margin-bottom: 5px;
            opacity: 0.9;
        }

        .total-price {
            font-size: 32px;
            font-weight: bold;
        }

        .error {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: #ffecec;
            color: #c62828;
            border-radius: 8px;
            font-size: 14px;
        }

        .note {
            margin-top: 18px;
            color: #666;
            font-size: 13px;
            line-height: 1.6;
        }

        @media (max-width: 600px) {

            .container {
                padding: 12px;
            }

            .card {
                padding: 18px;
                border-radius: 12px;
            }

            h1 {
                font-size: 23px;
            }

            .row {
                font-size: 14px;
                padding: 12px;
            }

            .total-price {
                font-size: 27px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card">

        <h1>🌾 Rice Weighment Calculator</h1>

        <p class="subtitle">
            Calculate Tarugu, net rice weight, 75 kg bags and total price
        </p>


        <!-- STOCK WEIGHT -->

        <div class="input-group">

            <label for="stockWeight">
                Total Stock / Lorry Weight (kg)
            </label>

            <input
                type="number"
                id="stockWeight"
                placeholder="Example: 3500"
                min="0"
                step="0.01"
            >

        </div>


        <!-- NUMBER OF EMPTY BAGS -->

        <div class="input-group">

            <label for="bagCount">
                Number of Empty Bags Used
            </label>

            <input
                type="number"
                id="bagCount"
                placeholder="Example: 100"
                min="0"
                step="1"
            >

        </div>


        <!-- PRICE -->

        <div class="input-group">

            <label for="bagPrice">
                Price of One Actual 75 kg Bag (₹)
            </label>

            <input
                type="number"
                id="bagPrice"
                placeholder="Example: 2500"
                min="0"
                step="0.01"
            >

        </div>


        <button onclick="calculate()">
            Calculate
        </button>


        <div id="error" class="error"></div>


        <!-- RESULTS -->

        <div id="result" class="result">

            <h2>📋 Calculation Details</h2>


            <div class="calculation">

                <!-- ORIGINAL WEIGHT -->

                <div class="row">
                    <span>Stock Weight</span>
                    <span id="grossWeight"></span>
                </div>


                <!-- TARUGU -->

                <div class="row highlight">
                    <span>Tarugu Rate</span>
                    <span>5 kg / 1 Ton</span>
                </div>

                <div class="row highlight">
                    <span>Tarugu Deduction</span>
                    <span id="tarugu"></span>
                </div>


                <!-- AFTER TARUGU -->

                <div class="row">
                    <span>Weight After Tarugu</span>
                    <span id="afterTarugu"></span>
                </div>


                <!-- BAGS -->

                <div class="row">
                    <span>Number of Empty Bags</span>
                    <span id="numberOfBags"></span>
                </div>

                <div class="row">
                    <span>Weight of One Empty Bag</span>
                    <span>1 kg</span>
                </div>

                <div class="row">
                    <span>Total Empty Bag Weight</span>
                    <span id="emptyBagWeight"></span>
                </div>


                <!-- NET WEIGHT -->

                <div class="row highlight">
                    <span>Net Rice Weight</span>
                    <span id="netWeight"></span>
                </div>


                <!-- ACTUAL BAGS -->

                <div class="row">
                    <span>Weight Per Actual Bag</span>
                    <span>75 kg</span>
                </div>

                <div class="row highlight">
                    <span>Actual 75 kg Bags</span>
                    <span id="actualBags"></span>
                </div>


                <!-- PRICE -->

                <div class="row">
                    <span>Price Per 75 kg Bag</span>
                    <span id="pricePerBag"></span>
                </div>

            </div>


            <!-- FORMULA -->

            <div class="formula">

                <strong>🧮 Calculation Formula</strong>

                <br><br>

                <strong>1. Tarugu</strong><br>
                Stock Weight ÷ 1000 × 5

                <br><br>

                <strong>2. Weight After Tarugu</strong><br>
                Stock Weight − Tarugu

                <br><br>

                <strong>3. Empty Bag Weight</strong><br>
                Number of Bags × 1 kg

                <br><br>

                <strong>4. Net Rice Weight</strong><br>
                Weight After Tarugu − Empty Bag Weight

                <br><br>

                <strong>5. Actual 75 kg Bags</strong><br>
                Net Rice Weight ÷ 75

                <br><br>

                <strong>6. Total Price</strong><br>
                Actual 75 kg Bags × Price Per Bag

            </div>


            <!-- TOTAL PRICE -->

            <div class="total">

                <div class="total-title">
                    TOTAL PRICE
                </div>

                <div class="total-price" id="totalPrice">
                    ₹0.00
                </div>

            </div>


            <!-- EXAMPLE -->

            <div class="note">

                <strong>Example:</strong>

                <br><br>

                Stock Weight = 3500 kg

                <br>

                Bags = 100

                <br>

                Price = ₹2500 per 75 kg bag

                <br><br>

                Tarugu:

                <br>

                3500 ÷ 1000 × 5 = <strong>17.5 kg</strong>

                <br><br>

                Weight After Tarugu:

                <br>

                3500 − 17.5 = <strong>3482.5 kg</strong>

                <br><br>

                Empty Bag Weight:

                <br>

                100 × 1 = <strong>100 kg</strong>

                <br><br>

                Net Rice:

                <br>

                3482.5 − 100 = <strong>3382.5 kg</strong>

                <br><br>

                Actual Bags:

                <br>

                3382.5 ÷ 75 = <strong>45.10 bags</strong>

            </div>

        </div>

    </div>

</div>


<script>

function formatNumber(value, decimals = 2) {

    return Number(value).toLocaleString("en-IN", {

        minimumFractionDigits: decimals,

        maximumFractionDigits: decimals

    });

}


function calculate() {

    const stockWeight =
        parseFloat(document.getElementById("stockWeight").value);

    const bagCount =
        parseFloat(document.getElementById("bagCount").value);

    const bagPrice =
        parseFloat(document.getElementById("bagPrice").value);


    const error =
        document.getElementById("error");

    const result =
        document.getElementById("result");


    error.style.display = "none";
    result.style.display = "none";


    // -----------------------------
    // INPUT VALIDATION
    // -----------------------------

    if (!Number.isFinite(stockWeight) || stockWeight <= 0) {

        error.textContent =
            "Please enter a valid stock weight.";

        error.style.display = "block";

        return;
    }


    if (!Number.isFinite(bagCount) || bagCount < 0) {

        error.textContent =
            "Please enter a valid number of bags.";

        error.style.display = "block";

        return;
    }


    if (!Number.isFinite(bagPrice) || bagPrice < 0) {

        error.textContent =
            "Please enter a valid price per 75 kg bag.";

        error.style.display = "block";

        return;
    }


    // -----------------------------
    // CONSTANTS
    // -----------------------------

    const EMPTY_BAG_WEIGHT = 1;
    const ACTUAL_BAG_WEIGHT = 75;
    const TARUGU_PER_TON = 5;


    // -----------------------------
    // 1. CALCULATE TARUGU
    // -----------------------------

    // IMPORTANT:
    // Tarugu is calculated BEFORE
    // removing empty bag weight.

    const tarugu =
        (stockWeight / 1000) * TARUGU_PER_TON;


    // -----------------------------
    // 2. REMOVE TARUGU
    // -----------------------------

    const afterTarugu =
        stockWeight - tarugu;


    // -----------------------------
    // 3. CALCULATE EMPTY BAG WEIGHT
    // -----------------------------

    const emptyBagWeight =
        bagCount * EMPTY_BAG_WEIGHT;


    // -----------------------------
    // 4. CALCULATE NET RICE WEIGHT
    // -----------------------------

    const netWeight =
        afterTarugu - emptyBagWeight;


    // -----------------------------
    // 5. CALCULATE ACTUAL 75 KG BAGS
    // -----------------------------

    const actualBags =
        netWeight / ACTUAL_BAG_WEIGHT;


    // -----------------------------
    // 6. CALCULATE TOTAL PRICE
    // -----------------------------

    const totalPrice =
        actualBags * bagPrice;


    // -----------------------------
    // DISPLAY RESULTS
    // -----------------------------

    document.getElementById("grossWeight").textContent =
        formatNumber(stockWeight) + " kg";


    document.getElementById("tarugu").textContent =
        formatNumber(tarugu) + " kg";


    document.getElementById("afterTarugu").textContent =
        formatNumber(afterTarugu) + " kg";


    document.getElementById("numberOfBags").textContent =
        formatNumber(bagCount, 0);


    document.getElementById("emptyBagWeight").textContent =
        formatNumber(emptyBagWeight) + " kg";


    document.getElementById("netWeight").textContent =
        formatNumber(netWeight) + " kg";


    document.getElementById("actualBags").textContent =
        formatNumber(actualBags, 4);


    document.getElementById("pricePerBag").textContent =
        "₹" + formatNumber(bagPrice);


    document.getElementById("totalPrice").textContent =
        "₹" + formatNumber(totalPrice);


    result.style.display = "block";

}


// Allow Enter key to calculate

document.addEventListener("keydown", function(event) {

    if (event.key === "Enter") {
        calculate();
    }

});

</script>

</body>
</html>
```
